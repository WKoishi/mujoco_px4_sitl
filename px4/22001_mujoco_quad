#!/bin/sh
#
# @name MuJoCo Quadrotor X (SITL, MAVLink HIL)
#
# @type Quadrotor X
#
# Airframe for mujoco_px4_sitl. Modelled on 10016_none_iris.
#
# With PX4_SIMULATOR unset, SYS_AUTOSTART non-zero and not 10017, and SIM_GZ_EN
# at its default of 0, every branch of px4-rc.simulator's if-chain fails and the
# else is taken, which sources px4-rc.mavlinksim. So do NOT set SIM_GZ_EN here.
#
# IMU_INTEG_RATE needs no entry: px4-rc.simulator already pins it to 250 for
# every posix simulator. 250 Hz is the rate the simulator must match.
#
# The CA_ROTOR* geometry below must match models/quad_x.xml exactly. Positions
# here are FRD (y right); the model states the same points in FLU (y left), so
# every PY here is the negation of the model's py. KM is positive for CCW.
#
#   rotor 0  front right  CCW
#   rotor 1  rear  left   CCW
#   rotor 2  front left   CW
#   rotor 3  rear  right  CW

. ${R}etc/init.d/rc.mc_defaults

param set-default CA_AIRFRAME 0

param set-default CA_ROTOR_COUNT 4

param set-default CA_ROTOR0_PX 0.17678
param set-default CA_ROTOR0_PY 0.17678
param set-default CA_ROTOR0_KM 0.05

param set-default CA_ROTOR1_PX -0.17678
param set-default CA_ROTOR1_PY -0.17678
param set-default CA_ROTOR1_KM 0.05

param set-default CA_ROTOR2_PX 0.17678
param set-default CA_ROTOR2_PY -0.17678
param set-default CA_ROTOR2_KM -0.05

param set-default CA_ROTOR3_PX -0.17678
param set-default CA_ROTOR3_PY 0.17678
param set-default CA_ROTOR3_KM -0.05

param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 102
param set-default PWM_MAIN_FUNC3 103
param set-default PWM_MAIN_FUNC4 104

# Declarative only: none of the sensor_*_sim modules reads its own SENS_EN_*SIM,
# and our .post starts all three unconditionally. Set so that `param show
# SENS_EN_*` reflects reality and the airframe matches how sihsim/gzsim express
# the same intent.
param set-default SENS_EN_BAROSIM 1
param set-default SENS_EN_MAGSIM 1
param set-default SENS_EN_GPSSIM 1

# Rotor speed is an explicit state in the model (MODELING_CONVENTIONS.md 2.5):
# omega = omega_idle + (omega_max - omega_idle) * u, T = c_t * omega^2, with a
# non-zero idle speed because an armed motor does not stop at zero command.
#
# These three parameters are one setting, not three. Changing any one alone
# leaves the vehicle flyable but mistuned, which is why they are adjacent.
#
# THR_MDL_FAC 1 is required for consistency with PX4's own rotor model, not
# merely to linearize ours. CA_ROTOR*_CT is defined as Thrust = CT * u^2
# (control_allocator/module.yaml:196-209), while the effectiveness matrix is
# linear in the actuator variable -- ct * axis and ct * position.cross(axis)
# (ActuatorEffectivenessRotors.cpp:195-198). The only way both hold is if the
# allocator's actuator variable is u^2, and FunctionMotors' sqrt at fac = 1 is
# what converts it back to u (mixer_module/functions/FunctionMotors.hpp:81-107).
# At fac = 0 that step is the identity, so the plant's square stays in the loop
# and every torque comes out exactly 2.00x what the allocator asked for -- the
# attitude loop running at twice its design gain. The factor is the one
# differentiating a square introduces, and is independent of omega_idle; see
# MODELING_CONVENTIONS.md 2.6 for the derivation. It flew anyway, inside PX4's
# default gain margin, which is why this needed asserting rather than trusting.
#
# MPC_THR_HOVER is in the allocator's domain, so it is u^2, not u. Hover is at
# u = 0.450 (omega_idle / omega_max = 1/11, thrust/weight 4.0 at full command),
# hence 0.450^2 = 0.2025. Measured: actuator_motors sits at MPC_THR_HOVER in
# hover, 1:1, so this parameter *is* the command at fac = 0 and its square root
# at fac = 1.
#
# MPC_THR_MIN must move with it, and forgetting this is the trap: the default
# 0.12 is a floor on the *setpoint*, so at fac = 1 it clamps the command at
# sqrt(0.12) = 0.346, i.e. 0.66 of vehicle weight. The vehicle cannot descend and
# landing drifts. 0.12^2 = 0.0144 restores the same command floor, and with it
# the identical physical range: T/W 0.160 to 4.000, same as fac = 0.
param set-default THR_MDL_FAC 1.0
param set-default MPC_THR_HOVER 0.2025
param set-default MPC_THR_MIN 0.0144
